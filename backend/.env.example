# PromptShield Backend - Environment Configuration Template
# ==========================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env    (Linux/Mac)
#   Copy-Item .env.example .env   (PowerShell)
#
# .env is git-ignored and will never be committed.
# This .env.example is safe to commit as a reference.

# =============================================================================
# Smart LLM Router
# =============================================================================
# Strategy: "local" | "cloud" | "auto"
#   local  = always use Ollama (no internet needed)
#   cloud  = always use the cloud provider below
#   auto   = route based on prompt complexity (short->local, complex->cloud)
PROMPTSHIELD_LLM_STRATEGY=local

# Cloud provider to use: "groq" | "bedrock" | "gemini"
PROMPTSHIELD_LLM_CLOUD_PROVIDER=groq

# Auto-routing: prompts with more words than this go to cloud
PROMPTSHIELD_LLM_AUTO_LENGTH_THRESHOLD=50

# Auto-routing: prompts with more PII entities than this go to cloud
PROMPTSHIELD_LLM_AUTO_ENTITY_THRESHOLD=3

# If cloud provider fails, fall back to local Ollama? (true/false)
PROMPTSHIELD_LLM_FALLBACK_TO_LOCAL=true

# If local Ollama fails (unreachable/timeout/bad output), fall back to the
# cloud provider above instead of giving up? (true/false). Local still gets
# its full OLLAMA_TIMEOUT/OLLAMA_MAX_RETRIES chance first - this only kicks
# in after local has actually exhausted that and failed.
PROMPTSHIELD_LLM_FALLBACK_TO_CLOUD=true

# =============================================================================
# Ollama (local LLM - no API key needed, just run `ollama serve`)
# =============================================================================
PROMPTSHIELD_OLLAMA_HOST=http://localhost:11434
PROMPTSHIELD_OLLAMA_MODEL=phi3:mini

# 20s dev-phase default, not "local's best shot" - the app never warms the
# model up, and phi3:mini on modest CPU hardware has been measured taking
# 30-180s+ regardless, so a long timeout here only delays the
# LLM_FALLBACK_TO_CLOUD path above with no real chance of local succeeding.
# Raise this once real local-inference infra exists.
PROMPTSHIELD_OLLAMA_TIMEOUT=20
PROMPTSHIELD_OLLAMA_MAX_RETRIES=1

# =============================================================================
# Groq (free tier: 30 req/min)
# Get your key: https://console.groq.com/keys
# =============================================================================
PROMPTSHIELD_GROQ_API_KEY=gsk_YOUR_KEY_HERE
PROMPTSHIELD_GROQ_MODEL=llama-3.1-8b-instant
PROMPTSHIELD_GROQ_TIMEOUT=30

# =============================================================================
# Google Gemini (free tier: 15 req/min)
# Get your key: https://aistudio.google.com/apikey
# =============================================================================
PROMPTSHIELD_GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
PROMPTSHIELD_GEMINI_MODEL=gemini-2.0-flash-lite
PROMPTSHIELD_GEMINI_TIMEOUT=30

# =============================================================================
# Amazon Bedrock (uses standard AWS credential chain)
# Configure via: aws configure, or set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
# =============================================================================
PROMPTSHIELD_BEDROCK_REGION=us-east-1
PROMPTSHIELD_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
PROMPTSHIELD_BEDROCK_TIMEOUT=30

# =============================================================================
# Presidio (PII detection sensitivity)
# =============================================================================
PROMPTSHIELD_PRESIDIO_MIN_SCORE=0.85

# =============================================================================
# Lexical Engine (TF-IDF scoring thresholds)
# =============================================================================
# Scores below this are classified PUBLIC (skip LLM)
PROMPTSHIELD_TFIDF_PUBLIC_THRESHOLD=0.15
# Scores at or above this are classified ENTERPRISE_LIKELY (skip LLM)
PROMPTSHIELD_TFIDF_ENTERPRISE_THRESHOLD=0.45

# =============================================================================
# Semantic Engine (embedding model and chunking)
# =============================================================================
# Sentence-transformer model for embeddings (downloaded on first run, ~80MB)
PROMPTSHIELD_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Approximate chunk size in characters for knowledge base splitting
PROMPTSHIELD_SEMANTIC_CHUNK_SIZE=500

# =============================================================================
# Hybrid Scoring (combines lexical + semantic for ambiguous cases)
# =============================================================================
# Weight for TF-IDF score in hybrid calculation
PROMPTSHIELD_HYBRID_LEXICAL_WEIGHT=0.4
# Weight for semantic similarity in hybrid calculation
PROMPTSHIELD_HYBRID_SEMANTIC_WEIGHT=0.6
# Hybrid scores below this are classified PUBLIC
PROMPTSHIELD_HYBRID_PUBLIC_THRESHOLD=0.30
# Hybrid scores at or above this are classified ENTERPRISE
PROMPTSHIELD_HYBRID_ENTERPRISE_THRESHOLD=0.55

# =============================================================================
# Legacy Fallback
# =============================================================================
# Set to "true" to revert to old keyword_search.py behavior (no TF-IDF/semantic)
PROMPTSHIELD_USE_LEGACY_SEARCH=false

# =============================================================================
# Authentication (see specs/authentication/)
# =============================================================================
# REQUIRED - no safe default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROMPTSHIELD_AUTH_SECRET_KEY=

# Access token (JWT) lifetime in minutes
PROMPTSHIELD_AUTH_TOKEN_EXPIRE_MINUTES=60

# bcrypt work factor for password/API-key hashing
PROMPTSHIELD_AUTH_BCRYPT_ROUNDS=12

# Minimum plaintext password length accepted at account creation
PROMPTSHIELD_AUTH_MIN_PASSWORD_LENGTH=8

# Login lockout after this many consecutive failed attempts, for this many minutes
PROMPTSHIELD_AUTH_LOGIN_MAX_ATTEMPTS=5
PROMPTSHIELD_AUTH_LOGIN_LOCKOUT_MINUTES=15

# SQLite path for users/devices/auth_audit_log - leave unset to default to
# backend/auth/auth.db (uncomment only to override; an empty value here would
# override the code default with an empty path)
# PROMPTSHIELD_AUTH_DB_PATH=/custom/path/auth.db

# Comma-separated origins allowed to call /auth/* and /devices/* - separate
# from /api/scan's wildcard CORS (see Requirement 8.1). Empty until a real
# dashboard origin exists.
PROMPTSHIELD_AUTH_ALLOWED_ORIGINS=

# =============================================================================
# Audit log / Dashboard (see backend/audit/README.md, backend/dashboard/README.md)
# =============================================================================
# SQLite path for the audit trail - leave unset to default to
# backend/audit/audit_log.db
# PROMPTSHIELD_AUDIT_DB_PATH=/custom/path/audit_log.db

# Note: the audit log always stores the raw (pre-Presidio) prompt alongside
# the masked version - a deliberate choice for this product's enterprise
# audit/compliance use case, not a generic default. Access is restricted:
# the dashboard (and everything in it, including raw prompts) requires the
# admin role - see backend/dashboard/README.md.
